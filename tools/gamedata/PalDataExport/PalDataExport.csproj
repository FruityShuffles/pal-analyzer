<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>PalDataExport</AssemblyName>
    <RootNamespace>PalDataExport</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Needs .NET 10 (see tools/gamedata/README.md); usmap v4 support landed only in this build. -->
    <PackageReference Include="CUE4Parse" Version="1.2.2.202607" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

</Project>
